{
  "name": "@cortex/schema",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "description": "Type-safe runtime schema validation with @cortex/result integration — parse, refine, and transform at runtime with zero any",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@cortex/result": "workspace:*"
  },
  "devDependencies": {
    "eslint": "^10.4.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
