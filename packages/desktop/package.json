{
  "name": "@cortex/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Cyrene Desktop — Electron + Live2D 桌宠",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:main && vite build",
    "dev": "npm run build:main && concurrently \"vite\" \"electron .\"",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@cortex/engine": "workspace:*",
    "@cortex/llm": "workspace:*",
    "@cortex/shared": "workspace:*",
    "pixi.js": "^7.3.0",
    "pixi-live2d-display": "0.5.0-beta",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.2.1",
    "electron": "^43.0.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  }
}
