{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "rootDir": ".",
    "outDir": "./dist-test",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    // 测试代码索引宽松化（2026-06-20 类型债专项，与 engine 同策）——base 的 noUncheckedIndexedAccess 关闭
    "noUncheckedIndexedAccess": false
  },
  "include": ["src", "tests"]
}
