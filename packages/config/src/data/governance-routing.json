{
  "$schema": "governance-routing-schema",
  "routes": [
    {
      "event": "SchedulerLoopCrashed",
      "channel": "urgent",
      "severity": "critical",
      "action": "notify"
    },
    {
      "event": "ErrorReported",
      "channel": "important",
      "severity": "high",
      "action": "notify"
    },
    {
      "event": "NodeComplete",
      "channel": "routine",
      "severity": "normal",
      "action": "log"
    }
  ]
}
