{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "rootDir": ".",
    "outDir": "./dist-test",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    // 测试代码索引宽松化（2026-06-20 测试类型债专项）：
    // base 的 noUncheckedIndexedAccess=true 使 53 文件 600+ 处数组索引报错——
    // 测试断言的索引访问（arr[0]/arr[i]）在运行时已由断言守护，
    // 关闭后 tsconfig.test.json 可编译——测试类型检查闭环（其他规则仍生效）。
    "noUncheckedIndexedAccess": false
  },
  "include": ["src", "tests"],
  "exclude": [
    "tests/e2e/solo-flight-mock.test.ts",
    "tests/e2e/multi-agent-collab-mock.test.ts",
    "tests/e2e/strategist-agent-mock.test.ts",
    // manual e2e 依赖 @cortex/cli 未导出符号（queryLoop/planMode）——类型检查豁免（2026-06-20）
    "tests/manual/e2e/tui-chain-e2e.test.ts",
    // manual e2e import tools/src 越界 rootDir——类型检查豁免（2026-06-20）
    "tests/manual/e2e/rollback-e2e.test.ts"
  ],
  "references": [
    { "path": "../shared" },
    { "path": "../llm" }
  ]
}
