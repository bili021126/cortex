{
  "name": "@cortex/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.src.json",
    "dev": "tsc -p tsconfig.src.json --watch",
    "typecheck": "tsc -p tsconfig.src.json --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e:skill": "tsc --outDir dist/e2e --rootDir . --module nodenext --moduleResolution nodenext --target ES2022 --esModuleInterop --skipLibCheck tests/manual/e2e/skill-fix-e2e.ts ; node dist/e2e/tests/manual/e2e/skill-fix-e2e.js"
  },
  "dependencies": {
    "@cortex/config": "workspace:*",
    "@cortex/factory": "workspace:*",
    "@cortex/llm": "workspace:*",
    "@cortex/shared": "workspace:*",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^11.0.0"
  },
  "devDependencies": {
    "@cortex/testing": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "eslint": "^10.3.0",
    "playwright": "^1.59.1",
    "tree-sitter": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "@vitest/coverage-v8": "^2.1.0"
  }
}
