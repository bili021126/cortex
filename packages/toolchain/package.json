{
  "name": "@cortex/toolchain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "description": "Plugin-based task runner for Cortex monorepo — lifecycle hooks (before/run/after/onError) with plugin hot-loading",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@cortex/result": "workspace:*",
    "zod": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^10.4.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0 <25.0.0",
    "pnpm": ">=9.0.0"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "toolchain": {
    "pluginDir": "./plugins",
    "lifecycleHooks": ["before", "run", "after", "onError"],
    "pluginProtocol": "npm-package"
  }
}
