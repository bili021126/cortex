{
  "name": "@cortex/plugin-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "二级插件运行器 — 管理外部/用户定义插件的生命周期、沙箱执行、注册表与 Schema 校验",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.src.json",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cortex/engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^10.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
