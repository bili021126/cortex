# Cortex 环境变量配置模板
# 复制此文件为 .env 并填入实际值

# ── 密钥管理（二选一）──
# 方案 A：pm 加密模式（推荐）
#   设置 PM_MASTER_KEY 后，Cortex 将从 .pm-data/vault.enc 加载密钥
#   使用 cortex pm 命令管理密钥，API Key 不再明文落盘
PM_MASTER_KEY=your-master-key-here
#
# 方案 B：环境变量直配模式（不设 PM_MASTER_KEY 时生效）
# 昔涟独立 API 密钥（独立人格 + CLI talk 模式）
# DEEPSEEK_CYRENE_API_KEY=sk-cyrene-key-here
# Chat 模型池 API 密钥（11 个标准工程 Agent 共享）
# DEEPSEEK_CHAT_API_KEY=sk-chat-pool-key-here
# Reasoner 模型 API 密钥（甘雨/钟离/霜凝 独立计费）
# DEEPSEEK_REASONER_API_KEY=sk-reasoner-key-here

# DeepSeek API 密钥（通用回退 Key，未设置独立 Key 时使用）
DEEPSEEK_API_KEY=sk-your-key-here

# API 基础 URL
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 对话模型（通用 Agent 执行 / 自审视 / 圆桌会议）
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash

# 推理模型（自审视深度分析，可选，默认回退到 CHAT_MODEL）
DEEPSEEK_REASONER_MODEL=deepseek-v4-flash

# 推理深度（仅 reasoning 模型生效，可选值: high / max）
DEEPSEEK_REASONING_EFFORT=high

# 自审视报告最大字符数（默认 15000）
SE_REPORT_MAX_CHARS=15000

# ConfirmGate 超时毫秒数（默认 120000）
CONFIRM_GATE_TIMEOUT_MS=120000

# 运行环境（production / development / test）
NODE_ENV=development

# ── API 权限控制（可选，不设则不限）──
# 每分钟请求上限
# CORTEX_LIMIT_CYRENE_RPM=30
# CORTEX_LIMIT_CHAT_RPM=60
# CORTEX_LIMIT_REASONER_RPM=10
# 每日 token 配额
# CORTEX_QUOTA_CYRENE_DAY_TOKENS=1000000
# CORTEX_QUOTA_CHAT_DAY_TOKENS=5000000
# CORTEX_QUOTA_REASONER_DAY_TOKENS=500000
# API 审计日志（默认开启，设为 0 关闭）
# CORTEX_API_AUDIT=1

# ── 搜索后端（可选，不配则仅使用内置 DuckDuckGo）──
# 必应中文搜索 MCP 无需 API Key，开箱即用
# 启用方式：cortex-agents.json 中将 bing.enabled 设为 true
