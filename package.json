{
  "name": "cortex",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev:engine": "pnpm --filter @cortex/engine dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:workspace": "vitest --workspace=vitest.workspace.ts",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "build:check": "pnpm build && pnpm test",
    "ci": "npx tsx scripts/ci-gate.ts",
    "ci:all": "npx tsx scripts/ci-gate.ts --all",
    "ci:dry": "npx tsx scripts/ci-gate.ts --dry-run",
    "self-exam": "npx tsx scripts/self-exam-soft.ts",
    "roundtable": "npx tsx packages/engine/tests/manual/scripts/conversation-11.ts",
    "build:config": "npx tsx scripts/build-config.ts",
    "cortex": "node packages/cli/dist/main.js",
    "daemon": "node packages/server/dist/main.js",
    "daemon:dev": "npx tsx packages/server/src/main.ts"
  },
  "engines": {
    "node": ">=20.0.0 <25.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@cortex/engine": "workspace:*",
    "@cortex/shared": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^10.4.1",
    "tsx": "^4.19.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "tree-sitter@0.25.0": "patches/tree-sitter@0.25.0.patch",
      "minimatch@10.2.5": "patches/minimatch@10.2.5.patch",
      "brace-expansion@5.0.6": "patches/brace-expansion@5.0.6.patch",
      "balanced-match@4.0.4": "patches/balanced-match@4.0.4.patch"
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
